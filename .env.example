# ==============================================================================
# CloudPilot - Complete Environment Configuration Template (Phases 1–8)
# Copy this file to .env for local development (do NOT commit .env to version control)
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# API Backend Configuration
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Web Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL Database Configuration
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=cloudpilot_dev_password
POSTGRES_DB=cloudpilot_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cloudpilot:cloudpilot_dev_password@localhost:5432/cloudpilot_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# GitHub OAuth Configuration (Phase 2.1)
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Security & Encryption (AES-256-GCM 32-byte / 64-hex character key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting & Resource Protection (Phase 8)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# AI Provider Configuration (Phase 6 & 8)
# Supported AI_PROVIDER values: 'mock' (default / offline), 'openai-compatible'
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_or_compatible_api_key
AI_MODEL=gpt-4o-mini
AI_SYNTHESIS_TIMEOUT_MS=30000

# Docker & Container Execution Limits (Phase 4 & 8)
MAX_BUILD_TIMEOUT_MS=300000
MAX_RUNTIME_MS=3600000
MAX_MEMORY_MB=512
MAX_CPU=1.0
MAX_LOG_BYTES=1048576

# Source Acquisition Limits (Phase 3.1 & 8)
MAX_REPO_SIZE_MB=50
MAX_FILE_COUNT=10000
MAX_FILE_SIZE_MB=10
SOURCE_ACQUISITION_TIMEOUT_MS=60000
